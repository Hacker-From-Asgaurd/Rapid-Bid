# Rapid Bid / Damper Quote Pro Frontend Environment Variables

# Backend API URL
# Local Development (leave empty or use http://localhost:8000):
# VITE_API_URL=http://localhost:8000

# Production Deployment (e.g. Render, Railway, Fly.io):
# VITE_API_URL=https://rapid-bid-backend.onrender.com

# If hosting frontend and backend on the same domain or behind a reverse proxy/nginx (e.g. Docker), leave blank to default to '/api':
# VITE_API_URL=/api
